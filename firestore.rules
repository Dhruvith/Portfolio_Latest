rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isPortfolioOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'dhruvith2004@gmail.com';
    }

    match /portfolio/public {
      allow read: if true;

      allow create, update: if isPortfolioOwner()
        && request.resource.data.keys().hasOnly(['content', 'updatedAt', 'updatedBy'])
        && request.resource.data.content is map
        && request.resource.data.updatedBy == request.auth.token.email
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
