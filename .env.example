# Firebase's browser configuration is public project metadata, not an admin secret.
# Copy this file to .env.local and replace the placeholders from:
# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=replace_me
VITE_FIREBASE_AUTH_DOMAIN=personalportfolio-e5033.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=personalportfolio-e5033
VITE_FIREBASE_STORAGE_BUCKET=personalportfolio-e5033.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_me
VITE_FIREBASE_APP_ID=replace_me

# Only this verified Firebase Authentication email may use the cloud Content Studio.
VITE_FIREBASE_ADMIN_EMAIL=dhruvith2004@gmail.com
VITE_CMS_BACKEND=firebase

# Set this after the public Firebase Hosting URL or custom domain is known.
VITE_PUBLIC_SITE_URL=http://localhost:4174
