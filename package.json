{
  "name": "dhruvith-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "cms": "node scripts/cms-dev.mjs",
    "cms:setup": "node scripts/cms-setup.mjs",
    "cms:server": "node scripts/cms-server.mjs",
    "cms:admin": "vite --config admin/vite.config.js",
    "cms:build": "vite build --config admin/vite.config.js",
    "import:timeline": "node scripts/import-timeline.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "firebase:login": "firebase login:add",
    "firebase:status": "firebase login:list && firebase projects:list",
    "firebase:emulators": "firebase emulators:start --only hosting,firestore",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules",
    "firebase:deploy:hosting": "firebase deploy --only hosting",
    "news:refresh": "node --env-file-if-exists=.env.news.local scripts/refresh-ai-news.mjs",
    "news:test": "node --test tests/ai-news.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "firebase": "^12.17.1",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.25",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "supercluster": "^8.0.1",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "firebase-tools": "^15.27.0",
    "simple-icons": "^16.27.1"
  }
}
